<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blue Vibes Store</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(to bottom right, #cfe8ff, #a0c4ff);
      color: #003366;
    }
    header {
      background-color: #003366;
      color: white;
      padding: 1rem;
      text-align: center;
    }
    h1 {
      margin: 0;
      font-family: 'Trebuchet MS', sans-serif;
      letter-spacing: 2px;
    }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      padding: 2rem;
    }
    .product {
      background-color: white;
      border-radius: 15px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      overflow: hidden;
      transition: transform 0.3s;
    }
    .product:hover {
      transform: scale(1.03);
    }
    .product img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    .product-info {
      padding: 1rem;
      text-align: center;
    }
    .product-title {
      font-size: 1.2rem;
      margin: 0.5rem 0;
      color: #003366;
    }
    .product-price {
      font-size: 1rem;
      color: #0055aa;
    }
    footer {
      text-align: center;
      padding: 1rem;
      background-color: #003366;
      color: white;
      margin-top: 2rem;
    }
  </style>
</head>
<body>
  <header>
    <h1>Blue Vibes Store</h1>
    <p>Feel the blue, shop the vibe!</p>
  </header>

  <section class="products">
    <div class="product">
      <img src="https://via.placeholder.com/300x200" alt="Product 1">
      <div class="product-info">
        <div class="product-title">Product Name 1</div>
        <div class="product-price">$29.99</div>
      </div>
    </div>

    <div class="product">
      <img src="https://via.placeholder.com/300x200" alt="Product 2">
      <div class="product-info">
        <div class="product-title">Product Name 2</div>
        <div class="product-price">$45.00</div>
      </div>
    </div>

    <div class="product">
      <img src="https://via.placeholder.com/300x200" alt="Product 3">
      <div class="product-info">
        <div class="product-title">Product Name 3</div>
        <div class="product-price">$19.50</div>
      </div>
    </div>
  </section>

  <footer>
    &copy; 2025 Blue Vibes Store. All rights reserved.
  </footer>
</body>
</html>
